# UIE runtime configuration
# API secrets belong in the hosting provider's secret environment, never source control.
UIE_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Reasoning provider: gemini (recommended for free-tier testing), openai, or native
# If unset, UIE selects Gemini when GEMINI_API_KEY is present, otherwise OpenAI when configured, otherwise native.
UIE_REASONING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI fallback (preserved)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
UIE_MEMORY_PATH=.data/learning.jsonl
