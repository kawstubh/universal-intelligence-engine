# UIE runtime configuration
# Public knowledge sources use Wikipedia and Europe PMC without paid search API keys.
OPENAI_API_KEY=
UIE_API_KEY=

# Optional
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
UIE_MEMORY_PATH=.data/learning.jsonl

# Optional Sarvam Token Factory provider (opt in with UIE_REASONING_PROVIDER=sarvam)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v2
SARVAM_MAX_TOKENS=512
SARVAM_TIMEOUT_SECONDS=60
UIE_REASONING_PROVIDER=native
