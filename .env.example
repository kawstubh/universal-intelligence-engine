# UIE runtime configuration
# Public knowledge sources use no paid search API key.
OPENAI_API_KEY=
UIE_API_KEY=

# Required when reasoning is enabled:
# Set this to a model name available in your OpenAI account. Do not use a guessed model name.
OPENAI_MODEL=
# Optional, defaults to the official OpenAI API:
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local learning store:
UIE_MEMORY_PATH=.data/learning.jsonl

# Optional local FreeLLMAPI integration. Synthetic smoke-test only; never patient data.
# The FreeLLMAPI desktop app listens on 127.0.0.1:31415 by default.
# Set these only in an isolated local/staging environment; do not commit real values.
# REASONING_PROVIDER=freellmapi
# REASONING_MODEL=auto:balanced
# REASONING_BASE_URL=http://127.0.0.1:31415/v1
# FREELLMAPI_API_KEY=<store locally; never commit>
# FREELLMAPI_SMOKE_TEST_ENABLED=true
