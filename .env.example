# UIE runtime configuration
# Public knowledge sources use no paid search API key.
OPENAI_API_KEY=
UIE_API_KEY=

# Required when reasoning is enabled:
# Set this to a model name available in your OpenAI account. Do not use a guessed model name.
OPENAI_MODEL=
# Optional, defaults to the official OpenAI API:
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local learning store:
UIE_MEMORY_PATH=.data/learning.jsonl
