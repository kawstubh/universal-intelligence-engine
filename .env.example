# UIE runtime configuration
# Public knowledge sources use no paid search API key.
OPENAI_API_KEY=
UIE_API_KEY=

# Required when reasoning is enabled:
# Set this to a model name available in your OpenAI account. Do not use a guessed model name.
OPENAI_MODEL=
# Optional, defaults to the official OpenAI API:
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local learning store:
UIE_MEMORY_PATH=.data/learning.jsonl

# Optional OpenAI-compatible FreeLLMAPI inference gateway.
# Local Windows desktop: http://127.0.0.1:31415/v1
# Hosted staging requires a private authenticated HTTPS tunnel or hosted gateway;
# never point Render at localhost and never expose the FreeLLMAPI dashboard publicly.
# Do not enable this provider for patient-specific data. The Dental bridge blocks
# known patient/clinical-record context while REASONING_PROVIDER=freellmapi.
# REASONING_PROVIDER=freellmapi
# FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
# FREELLMAPI_MODEL=auto
# FREELLMAPI_API_KEY=
