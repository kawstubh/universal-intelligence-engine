# Dental API backend
# Production: PostgreSQL connection string supplied as a server-side secret.
# Set this only after verifying the database attached to the target service.
# Do not infer the active Render DATABASE_URL from the Neon recovery project.
DATABASE_URL=
DENTAL_AUTO_MIGRATE=false
# anonymized = no patient identifiers/date-time sent to AI; full = explicit opt-in
AI_PATIENT_DATA_MODE=anonymized

# Oralyn's public patient journey is account-free. Keep this false.
# The legacy Supabase patient-account/linking API is dormant compatibility only.
DENTAL_PATIENT_ACCOUNT_PORTAL_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UIE_API_URL=
UIE_API_KEY=
DENTAL_API_KEY=
# Optional one-time clinic admin bootstrap. Use a strong password (12+ chars); never commit real values.
DENTAL_BOOTSTRAP_ADMIN_EMAIL=
DENTAL_BOOTSTRAP_ADMIN_PASSWORD=

# UIE providers are server-side only. Never put these in the mobile apps.
REASONING_PROVIDER=gemini
REASONING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REASONING_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GROQ_API_KEY=
REASONING_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Public knowledge sources use Wikipedia and Europe PMC without paid search API keys.

# Official scanO / scanKit integration
SCANO_MODE=disabled
SCANO_API_URL=
SCANO_API_KEY=

# Official WhatsApp Business Cloud API
WHATSAPP_MODE=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# SaaS membership / billing
DENTAL_MASTER_CLINIC_ID=dr-pranali
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Exact browser origins allowed to call the dental API. This example is for local development only.
# Staging/production must replace this with the exact deployed HTTPS portal origin.
# If unset, cross-origin browser access is denied.
DENTAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private object storage for clinical documents. Configure only in isolated staging
# after independently verifying the bucket is private and credentials are prefix-scoped.
DENTAL_DOCUMENTS_S3_ENDPOINT=
DENTAL_DOCUMENTS_S3_REGION=ap-southeast-1
DENTAL_DOCUMENTS_S3_BUCKET=
DENTAL_DOCUMENTS_S3_ACCESS_KEY_ID=
DENTAL_DOCUMENTS_S3_SECRET_ACCESS_KEY=
DENTAL_DOCUMENTS_STORAGE_PRIVATE=false
DENTAL_DOCUMENTS_UPLOAD_TTL_SECONDS=300
DENTAL_DOCUMENTS_DOWNLOAD_TTL_SECONDS=120

# Mandatory private-network ClamAV scanning for patient document uploads.
# Use an internal service hostname or private IP; public scanner endpoints are rejected.
# Leave the attestation false until the private scanner is independently verified.
DENTAL_DOCUMENT_SCANNER_HOST=
DENTAL_DOCUMENT_SCANNER_PORT=3310
DENTAL_DOCUMENT_SCANNER_TIMEOUT_SECONDS=20
DENTAL_DOCUMENT_SCANNER_PRIVATE=false
