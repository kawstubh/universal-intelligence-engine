# Dental API backend
# Production: Render Postgres connection string, supplied by Render when the DB is connected to the service.
DATABASE_URL=
DENTAL_AUTO_MIGRATE=false
# anonymized = no patient identifiers/date-time sent to AI; full = explicit opt-in
AI_PATIENT_DATA_MODE=anonymized

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UIE_API_URL=
UIE_API_KEY=
DENTAL_API_KEY=
DENTAL_GOOGLE_ALLOWED_EMAIL=

# UIE providers are server-side only. Never put these in the mobile apps.
REASONING_PROVIDER=gemini
REASONING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REASONING_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GROQ_API_KEY=
REASONING_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
BRAVE_SEARCH_API_KEY=

# Official scanO / scanKit integration
SCANO_MODE=disabled
SCANO_API_URL=
SCANO_API_KEY=

# Official WhatsApp Business Cloud API
WHATSAPP_MODE=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# SaaS membership / billing
DENTAL_MASTER_CLINIC_ID=dr-pranali
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
